                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('created', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "if (j.ok) { pm.collectionVariables.set('bookingId', j.data.id); pm.collectionVariables.set('externalRef', j.data.external_ref); }"
                ]
              }
            }
          ]
