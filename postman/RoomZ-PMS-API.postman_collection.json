{
  "info": {
    "_postman_id": "26e1e8f4-cf43-42f4-8dd1-8de01e5d2c49",
    "name": "RoomZ PMS API v1",
    "description": "RoomZ PMS public API: availability, rates and bookings.\n\n1. Import this collection and the environment file, pick the environment.\n2. Fill in **pmsUsername** / **pmsPassword** (a PMS admin).\n3. Run **1. Admin > Create API key**. The key is saved into `{{apiKey}}` automatically.\n4. Run anything else. Requests use `Authorization: Bearer {{apiKey}}`.\n\nFull guide: https://github.com/vf-platform-dev/pms-connector (endpoints.md and docs/)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Default stay dates: 30 days from today, 2 nights. Override checkIn/checkOut in your environment.",
          "function d(n){ const x = new Date(); x.setDate(x.getDate()+n); return x.toISOString().slice(0,10); }",
          "if (!pm.environment.get('checkIn') && !pm.collectionVariables.get('checkIn')) {",
          "  pm.collectionVariables.set('checkIn', d(30)); pm.collectionVariables.set('checkOut', d(32)); pm.collectionVariables.set('checkOutLater', d(33));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "propertyId",
      "value": ""
    },
    {
      "key": "roomTypeId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "externalRef",
      "value": ""
    },
    {
      "key": "apiKeyId",
      "value": ""
    },
    {
      "key": "checkIn",
      "value": ""
    },
    {
      "key": "checkOut",
      "value": ""
    },
    {
      "key": "checkOutLater",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Admin - API keys",
      "description": "Sign in with a PMS user who can edit Role Permissions (admins always can). HTTPS only. Set **pmsUsername** and **pmsPassword** in your environment first.",
      "item": [
        {
          "name": "Create API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api-keys"
              ]
            },
            "description": "Creates a key and saves it to `{{apiKey}}` automatically. The full key is returned **only in this response**.\n\nScopes: availability:read, rates:read, bookings:read, bookings:read_all, bookings:write, bookings:confirm, bookings:cancel, bookings:waive.\nOptional: property_ids (empty = all), agent_id (contract rates), booking_source, allowed_ips, allowed_origins, rate_limit_per_minute, notes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman - {{$timestamp}}\",\n  \"scopes\": [\n    \"availability:read\",\n    \"rates:read\",\n    \"bookings:read\",\n    \"bookings:write\",\n    \"bookings:cancel\"\n  ],\n  \"property_ids\": [],\n  \"booking_source\": \"postman\",\n  \"notes\": \"Created from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{pmsUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{pmsPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('key created', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "if (j.ok) {",
                  "  pm.environment.set('apiKey', j.data.api_key);",
                  "  pm.collectionVariables.set('apiKey', j.data.api_key);",
                  "  pm.collectionVariables.set('apiKeyId', j.data.id);",
                  "  console.log('Saved new API key to {{apiKey}} - it is shown only once:', j.data.api_key);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List API keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api-keys"
              ]
            },
            "description": "All keys with their access. The secret part of a key is never returned.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{pmsUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{pmsPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', function () { pm.expect(pm.response.json().ok).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
