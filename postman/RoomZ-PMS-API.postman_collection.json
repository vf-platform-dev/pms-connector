    {
      "name": "4. Bookings",
      "description": "Bookings made here are REAL bookings in the PMS. Use a test property or cancel them afterwards.",
      "item": [
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Reuse the same value when retrying the same request, so it can't run twice."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "description": "Stores the new booking in `{{bookingId}}`. Status is provisional unless the key has bookings:confirm.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"property_id\": \"{{propertyId}}\",\n  \"check_in\": \"{{checkIn}}\",\n  \"check_out\": \"{{checkOut}}\",\n  \"meal_plan\": \"BB\",\n  \"external_ref\": \"POSTMAN-{{$timestamp}}\",\n  \"expected_arrival_time\": \"14:30\",\n  \"notes\": \"Test booking from Postman\",\n  \"guest\": {\n    \"firstname\": \"Test\",\n    \"lastname\": \"Guest\",\n    \"email\": \"test.guest@example.com\",\n    \"phone\": \"+263770000000\"\n  },\n  \"rooms\": [\n    {\n      \"room_type_id\": \"{{roomTypeId}}\",\n      \"adults\": 2,\n      \"children\": 0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
